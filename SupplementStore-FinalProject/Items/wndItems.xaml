<Window x:Class="SupplementStore_FinalProject.Items.wndItems"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Supplement Store - Item Management"
        Height="650"
        Width="950"
        MinHeight="550"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#F6FBF4">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- heading -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">

            <TextBlock Text="Supplement Inventory Management"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextBrushDark}"/>

            <TextBlock Text="Add, update, and manage store supplements."
                       FontSize="14"
                       Foreground="{StaticResource SubtleTextBrush}"
                       Margin="0,6,0,0"/>

        </StackPanel>

        <!-- inv DataGrid -->
        <GroupBox Grid.Row="1"
                  Header="Available Supplements">

            <DataGrid x:Name="dgItems"
                      SelectionChanged="dgItems_SelectionChanged">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Item Code"
                                        Binding="{Binding ItemCode}"
                                        Width="130"/>

                    <DataGridTextColumn Header="Description"
                                        Binding="{Binding ItemDescription}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Cost"
                                        Binding="{Binding ItemCost, StringFormat={}{0:C}}"
                                        Width="130"/>

                </DataGrid.Columns>

            </DataGrid>

        </GroupBox>

        <!-- item details -->
        <GroupBox Grid.Row="2"
                  Header="Item Details">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Margin="0,0,15,0">

                    <Label Content="Item Code"/>
                    <TextBox x:Name="txtItemCode"
                             MaxLength="20"/>

                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="0,0,15,0">

                    <Label Content="Item Description"/>
                    <TextBox x:Name="txtDescription"
                             MaxLength="255"/>

                </StackPanel>

                <StackPanel Grid.Column="2">

                    <Label Content="Item Cost"/>
                    <TextBox x:Name="txtCost"/>

                </StackPanel>

            </Grid>

        </GroupBox>

        <!-- btns -->
        <WrapPanel Grid.Row="3"
                   HorizontalAlignment="Center">

            <Button x:Name="btnAdd"
                    Content="Add Item"
                    Click="btnAdd_Click"/>

            <Button x:Name="btnUpdate"
                    Content="Update Item"
                    Click="btnUpdate_Click"/>

            <Button x:Name="btnDelete"
                    Content="Delete Item"
                    Click="btnDelete_Click"/>

            <Button x:Name="btnClear"
                    Content="Clear"
                    Click="btnClear_Click"/>

            <Button x:Name="btnClose"
                    Content="Close"
                    Click="btnClose_Click"/>

        </WrapPanel>

    </Grid>
</Window>