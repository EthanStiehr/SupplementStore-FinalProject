<Window x:Class="SupplementStore_FinalProject.Items.wndItems"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Supplement Store - Item Management"
        Height="650"
        Width="950"
        MinHeight="550"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#F6FBF4">

    <Window.Resources>

        <!-- color palette -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#5A8F5A"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#88B488"/>
        <SolidColorBrush x:Key="LightAccentBrush" Color="#EEF7EA"/>
        <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#C7D8C2"/>
        <SolidColorBrush x:Key="TextBrushDark" Color="#2F4B2F"/>
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#5B6F5B"/>

        <!-- GroupBox -->
        <Style TargetType="GroupBox">
            <Setter Property="Background" Value="#F9FCF8"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrushDark}"/>
        </Style>

        <!-- lbl style -->
        <Style TargetType="Label">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrushDark}"/>
        </Style>

        <!-- txt style -->
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
            <Setter Property="Background" Value="{StaticResource WhiteBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#2E2E2E"/>
        </Style>

        <!-- btn style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="MinWidth" Value="105"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- DataGrid style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="RowBackground" Value="#FFFFFF"/>
            <Setter Property="AlternatingRowBackground" Value="#F2F8EE"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#DDE9D8"/>
            <Setter Property="VerticalGridLinesBrush" Value="#DDE9D8"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>

        <!-- DataGrid header style -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E7F2E2"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrushDark}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#D5E3CF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

    </Window.Resources>

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- heading -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">

            <TextBlock Text="Supplement Inventory Management"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextBrushDark}"/>

            <TextBlock Text="Add, update, and manage store supplements."
                       FontSize="14"
                       Foreground="{StaticResource SubtleTextBrush}"
                       Margin="0,6,0,0"/>

        </StackPanel>

        <!-- inv DataGrid -->
        <GroupBox Grid.Row="1"
                  Header="Available Supplements">

            <DataGrid x:Name="dgItems"
                      SelectionChanged="dgItems_SelectionChanged">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Item Code"
                                        Binding="{Binding ItemCode}"
                                        Width="130"/>

                    <DataGridTextColumn Header="Description"
                                        Binding="{Binding ItemDescription}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Cost"
                                        Binding="{Binding ItemCost, StringFormat={}{0:C}}"
                                        Width="130"/>

                </DataGrid.Columns>

            </DataGrid>

        </GroupBox>

        <!-- item details -->
        <GroupBox Grid.Row="2"
                  Header="Item Details">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Margin="0,0,15,0">

                    <Label Content="Item Code"/>
                    <TextBox x:Name="txtItemCode"
                             MaxLength="20"/>

                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="0,0,15,0">

                    <Label Content="Item Description"/>
                    <TextBox x:Name="txtDescription"
                             MaxLength="255"/>

                </StackPanel>

                <StackPanel Grid.Column="2">

                    <Label Content="Item Cost"/>
                    <TextBox x:Name="txtCost"/>

                </StackPanel>

            </Grid>

        </GroupBox>

        <!-- btns -->
        <WrapPanel Grid.Row="3"
                   HorizontalAlignment="Center">

            <Button x:Name="btnAdd"
                    Content="Add Item"
                    Click="btnAdd_Click"/>

            <Button x:Name="btnUpdate"
                    Content="Update Item"
                    Click="btnUpdate_Click"/>

            <Button x:Name="btnDelete"
                    Content="Delete Item"
                    Click="btnDelete_Click"/>

            <Button x:Name="btnClear"
                    Content="Clear"
                    Click="btnClear_Click"/>

            <Button x:Name="btnClose"
                    Content="Close"
                    Click="btnClose_Click"/>

        </WrapPanel>

    </Grid>
</Window>