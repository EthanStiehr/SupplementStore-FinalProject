<Window x:Class="SupplementStore_FinalProject.wndMain"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            Title="Supplement Store - Home"
    Height="650"
    Width="950"
    MinHeight="550"
    MinWidth="800"
    WindowStartupLocation="CenterScreen"
    Background="#F6FBF4">

    <Grid Margin="25">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
        
        <!-- Navigation -->
        <WrapPanel Grid.Row="0" HorizontalAlignment="Left">
           <Button x:Name="btnSearch" Content="Search"     Click="btnSearch_Click"/>
           <Button x:Name="btnItems"  Content="Edit Items" Click="btnItems_Click"/>
        </WrapPanel>

        <!-- Invoice Settings -->
        <WrapPanel Grid.Row="1" HorizontalAlignment="Center">
            <Button x:Name="btnEditInv" Content="Edit Invoice" Click="btnEditInv_Click"/>
            <Button x:Name="btnSaveInv" Content="Save Invoice" Click="btnSaveInv_Click"/>
        </WrapPanel>
        
        <!-- Main Page -->
        <GroupBox Grid.Row="2" x:Name="grpMain" IsEnabled="False">
            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                <!-- Invoice Details -->
                <Label Content="Invoice Date:"/>
                <TextBox x:Name="txtInvDate"/>

                <Label Content="Invoice Number:"/>
                <TextBox x:Name="txtInvNumber"/>

                <Label Content="Total Cost:"/>
                <TextBox x:Name="txtInvCost"/>

                <!-- Item Settings -->
                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,15,0">
                    <Label Content="Items:"/>
                    <ComboBox x:Name="cmbItems"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,30,15,0">
                    <Button Content="Add Item" Click="btnAddItem_Click"/>
                </StackPanel>
                <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,15,0">
                    <Label Content="Cost:"/>
                    <TextBox x:Name="txtItemCost"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Grid.Row="1" Margin="0,0,15,0">
                    <Button Content="Remove Item" Click="btnRemoveItem_Click"/>
                </StackPanel>
                </Grid>

            </StackPanel>

            <StackPanel Grid.Column="1" Margin="0,0,15,0">
				<Label Content="Invoice Items:"/>
				<DataGrid x:Name="dgInvoiceItems"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow">
					<DataGrid.Columns>
						<DataGridTextColumn Header="Item Code" Binding="{Binding ItemCode}" Width="*"/>
						<DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*"/>
						<DataGridTextColumn Header="Cost" Binding="{Binding Cost}" Width="*"/>
					</DataGrid.Columns>
				</DataGrid>

            </StackPanel>
			

            </Grid>
        </GroupBox>

    </Grid>
</Window>
